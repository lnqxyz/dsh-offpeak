{
  "name": "dsh-offpeak",
  "version": "0.1.19",
  "type": "module",
  "description": "错峰发送：高峰时段（周一至周五 09:00-12:00、14:00-18:00）不立即发出模型调用，等到最近的低谷再发。",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./peak-window": "./lib/peak-window.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/peak-window.js",
    "lib/resume-turn.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "off-peak",
    "pricing"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/peak-window.test.mjs test/gate.test.mjs test/model-gate.test.mjs test/integration.test.mjs test/routes.test.mjs test/recover.test.mjs test/resume-turn.test.mjs test/version.test.mjs test/client.test.mjs"
  }
}
